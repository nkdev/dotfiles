# =====================================================================
# 🌟 4大フォント切り替え設定（半角スペース対応・完全版）
# =====================================================================

# --- 🟢 1. HackGen（白源：ゼロがドット） ---
# font-family = "HackGen Console NF"

# --- 🔵 2. UDEV Gothic（クッキリUD：ゼロが斜線） ---
# font-family = "UDEV Gothic NF"

# --- 🟤 3. PlemolJP（知的・硬派：ゼロがドットで縦長） ---
# font-family = "PlemolJP Console"

# --- 🚀 4. Moralerspace（最先端：ゼロがうねるドット、％がひし形） ---
font-family = "Moralerspace Neon HW"


# =====================================================================
# 👁️ 表示サイズ・バックアップ調整
# =====================================================================
# フォントサイズ（お好みに合わせて微調整してください）
font-size = 14

# 日本語と英数字のバックアップ（表示崩れを防ぐお守り設定）
font-family = Hiragino Sans
font-family = Menlo

# 空白・全角スペースの可視化を強制有効化（全角スペースに点線四角が出ます）
font-feature = +calt
font-feature = +liga


# =====================================================================
# 🌐 Ghostty 外観モダン化・ブラウザ風カスタム（最新仕様版）
# =====================================================================

# 1. ウィンドウの背景を絶妙に「半透明（シースルー）」にする設定 (0.0〜1.0)
# (後ろの壁紙がうっすら透けて、一気にデスクトップに馴染むモダンな質感になります)
background-opacity = 0.90

# 2. 背景の「ぼかし（ブラー）」を有効化
# (文字の後ろがすりガラスのように上品にボケるため、半透明にしても文字がクッキリ読めます)
background-blur-radius = 20

# 3. 外観のテーマを Mac のシステム設定（ライト/ダーク）に完全に同期させる
# (これで余計な枠線がなくなり、OS標準の最も美しいネイティブタブバーになります)
window-theme = "system"

# 4. Mac の美しいディスプレイ発色（Display P3）を100%活かす色の設定
window-colorspace = "display-p3"

# 5. ウィンドウのフチ（内側の余白）を調整
# (文字が画面の端にギチギチに張り付くのを防ぎ、上下左右に心地よい余白を持たせます)
window-padding-x = 12
window-padding-y = 12

